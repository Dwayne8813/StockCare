<aside class="sidebar">
  <div style="padding: 16px 14px 18px; margin-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; align-items: center; gap: 11px;">
    <div style="width: 34px; height: 34px; border-radius: 8px; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
        <line x1="12" y1="22.08" x2="12" y2="12"></line>
      </svg>
    </div>
    <div style="line-height: 1.2;">
      <div style="color: #ffffff; font-weight: 700; font-size: 16px; letter-spacing: -0.01em;">StockCare</div>
      <div style="color: #94a3b8; font-size: 11px; font-weight: 500;">Kitchen Inventory</div>
    </div>
  </div>

  <nav class="nav">
    <a href="/inventory" class="{{#if nav.dashboard}}active{{/if}}">
      <span class="ico"><img src="/icons/dashboard.png" alt="" style="width: 18px; height: 18px; object-fit: contain; filter: brightness(0) invert(1); display: block;" /></span>Dashboard
    </a>
    <a href="/inventory/add" class="{{#if nav.add}}active{{/if}}">
      <span class="ico"><img src="/icons/add.png" alt="" style="width: 18px; height: 18px; object-fit: contain; filter: brightness(0) invert(1); display: block;" /></span>Add Product
    </a>
    <a href="/history" class="{{#if nav.history}}active{{/if}}">
      <span class="ico"><img src="/icons/history.png" alt="" style="width: 18px; height: 18px; object-fit: contain; filter: brightness(0) invert(1); display: block;" /></span>History
    </a>
    <a href="/audit-logs" class="{{#if nav.audit}}active{{/if}}">
      <span class="ico"><img src="/icons/security%20audit%20logs.png" alt="" style="width: 18px; height: 18px; object-fit: contain; filter: brightness(0) invert(1); display: block;" /></span>Security Audit Logs
    </a>
    <a href="/waste" class="{{#if nav.waste}}active{{/if}}">
      <span class="ico"><img src="/icons/waste%20logs.png" alt="" style="width: 18px; height: 18px; object-fit: contain; filter: brightness(0) invert(1); display: block;" /></span>Waste Log
    </a>
  </nav>
  <form method="POST" action="/logout" class="logout-form">
    <button type="submit" class="logout-btn"><span class="ico">&#128682;</span>Logout</button>
  </form>
</aside>
